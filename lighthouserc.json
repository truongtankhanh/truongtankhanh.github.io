{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm dlx serve@14.2.4 dist --listen 4173 --no-clipboard",
      "startServerReadyPattern": "Accepting connections",
      "startServerReadyTimeout": 90000,
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/cv/",
        "http://localhost:4173/work/ops-command-center/"
      ],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--no-sandbox" }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:4173/(work/[^/]+/?)?$",
          "aggregationMethod": "median-run",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 1 }],
            "categories:seo": ["error", { "minScore": 1 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.01 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:4173/cv/?$",
          "aggregationMethod": "median-run",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 1 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.01 }]
          }
        }
      ]
    }
  }
}
